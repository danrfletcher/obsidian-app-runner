{
  "name": "obsidian-app-runner",
  "version": "0.1.1",
  "description": "Register local apps with a start command, open them in tabs, and stop them when the last tab closes.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
